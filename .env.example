# ==============================================================================
# SATAS Bus - Environment Configuration
# ==============================================================================

APP_NAME="SATAS Bus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8005

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# Database Configuration (Docker defaults to MySQL/MariaDB service 'db')
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bookbus
DB_USERNAME=bookbus
DB_PASSWORD=secret

# For local standalone running with SQLite without Docker:
# DB_CONNECTION=sqlite
# DB_DATABASE=/path/to/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@satasbus.ma"
MAIL_FROM_NAME="${APP_NAME}"
